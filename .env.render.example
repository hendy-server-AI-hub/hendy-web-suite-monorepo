# Copy to .env.render and DO NOT COMMIT IT.
# The production bootstrap writes this file locally with mode 0600.
HENDY_API_URL=https://YOUR_WORKER_URL
RENDER_SERVICE_TOKEN=GENERATED_BY_npm_run_bootstrap:production
RENDER_WORKER_ID=render-host-1
POLL_INTERVAL_MS=2000
JOB_TIMEOUT_MS=2700000
MAX_INPUT_BYTES=262144000
MAX_OUTPUT_BYTES=83886080
